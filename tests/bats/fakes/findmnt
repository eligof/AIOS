#!/usr/bin/env bash
# Fake findmnt for tests/bats/aios-health.bats.
# Mount point M counts as mounted when the file $FAKE_MOUNTS/M exists (e.g. $FAKE_MOUNTS/var/log).
# Each line of the file is the OPTIONS column of one mount on M, in mount order, so more
# than one line means stacked mounts. Supported forms:
#   findmnt -fno OPTIONS -M M   prints the options of the first mount on M only
#   findmnt -n M                prints a findmnt-style row per mount
# All exit 1 when M is not mounted, like the real findmnt.
set -euo pipefail

target=""
for target in "$@"; do :; done
file="$FAKE_MOUNTS$target"
[ -f "$file" ] || exit 1

if [ "$#" -eq 4 ] && [ "$1" = -fno ] && [ "$2" = OPTIONS ] && [ "$3" = -M ]; then
    head -n 1 "$file"
elif [ "$#" -eq 2 ] && [ "$1" = -n ]; then
    while IFS= read -r opts; do
        printf '%s /dev/mapper/aios btrfs %s\n' "$target" "$opts"
    done <"$file"
else
    echo "fake findmnt: unsupported: $*" >&2
    exit 2
fi
