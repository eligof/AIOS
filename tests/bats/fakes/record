#!/usr/bin/env bash
# Fake mount/umount for tests/bats/aios-root.bats: records "<name> <args>" in $CALLS and
# succeeds, unless that line also appears verbatim in the file $FAILS (then it exits 1).
set -euo pipefail

call="${0##*/} $*"
echo "$call" >>"$CALLS"
if [ -n "${FAILS:-}" ] && [ -f "$FAILS" ] && grep -qxF -- "$call" "$FAILS"; then
    echo "${0##*/}: injected failure: $call" >&2
    exit 1
fi
